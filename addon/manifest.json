{
  "manifest_version": 3,
  "name": "Peersky Onboarding Extension",
  "short_name": "Peersky Onboarding",
  "author": "Akhilesh Thite",
  "version": "1.0.0",
  "description": "Export tabs for Peersky Browser migration.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "tabs"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "onboarding-extension@p2plabs.xyz",
      "strict_min_version": "109.0"
    }
  }
}
